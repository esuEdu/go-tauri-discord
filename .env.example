# Copy to .env and adjust. The server reads plain environment variables, so
# `set -a && source .env && set +a` or your process manager both work.

ENV=development
HTTP_ADDR=:8080

DATABASE_URL=postgres://vocalis:vocalis@localhost:5432/vocalis?sslmode=disable

# The server applies pending migrations at boot, under a Postgres advisory
# lock. Set false to apply them yourself with `make migrate`.
MIGRATE_ON_START=true

# Required when ENV=production; must be at least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
HEARTBEAT_INTERVAL=30s

# Vite dev server and the packaged Tauri webview, respectively.
CORS_ORIGINS=http://localhost:1420,tauri://localhost

# Only these peers may set X-Forwarded-For / CF-Connecting-IP. Loopback covers
# cloudflared and a local reverse proxy. Widen it only for proxies you run:
# anything trusted here can claim to be any client, which defeats per-IP limits.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

RATE_LIMIT_DISABLED=
REGISTER_PER_HOUR=10
LOGIN_PER_MINUTE=20
MESSAGES_PER_MINUTE=60
MAX_SESSIONS_PER_USER=5

# Where uploaded pictures live. "disk" needs nothing; "s3" talks to MinIO or
# anything S3-compatible (docker compose --profile storage up brings MinIO up).
STORAGE=disk
STORAGE_DIR=./data/files
S3_ENDPOINT=localhost:9000
S3_BUCKET=vocalis
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_SSL=
# How long a signed attachment url stays valid.
ATTACHMENT_URL_TTL=24h

ICE_SERVERS=stun:stun.l.google.com:19302
# Entries are comma-separated, each either a bare url or url|username|credential.
# A turn: entry with no credentials of its own is signed with TURN_SECRET, which
# must match the secret the TURN server was started with (coturn: use-auth-secret).
TURN_SECRET=
TURN_TTL=12h
VOICE_DISABLED=

# The address clients reach this server on. Leave empty when the machine holds
# its public address directly (a plain VPS). Set it whenever the public address
# is mapped to a private NIC — AWS EC2, GCP, or docker without host networking —
# because otherwise the SFU offers only private candidates and media never flows.
WEBRTC_PUBLIC_IP=

# The UDP ports the SFU gathers on. Open exactly this range on the firewall.
# Widen it if you expect more than a few hundred concurrent voice connections:
# every peer takes a port per network interface.
WEBRTC_UDP_PORT_MIN=50000
WEBRTC_UDP_PORT_MAX=50999
