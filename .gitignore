# ---------------------------------------------------------------------------
# go-tauri-discord — monorepo (Go server + Tauri/Rust + React/TS client)
# ---------------------------------------------------------------------------

# ===========================
# Go (server/)
# ===========================
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Compiled server binaries
server/bin/
bin/
vocalis-server
vocalis-server.exe

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# ===========================
# Node / React / Vite (client/)
# ===========================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Build output
dist/
dist-ssr/
build/
out/
*.local

# Vite / bundler caches
.vite/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===========================
# Tauri / Rust (client/src-tauri/)
# ===========================
target/
**/target/
debug/
**/*.rs.bk
*.pdb

# Tauri build artifacts & generated files
client/src-tauri/gen/
client/src-tauri/WixTools/
client/src-tauri/.tauri/

# Signing keys — never commit these
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
tauri-private.key
*.tauri.key

# ===========================
# Secrets & local config
# ===========================
.env
.env.*
!.env.example
!.env.sample
*.env.local
secrets.json
config.local.*

