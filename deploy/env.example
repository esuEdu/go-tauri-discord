# Production configuration for docker-compose.prod.yml. Copy it to .env at the
# repo root — `make deploy-env` does exactly that and fills both secrets with
# generated values. The development targets read .env.example instead; this
# file exists because a deployment wants different answers, not more of them.

ENV=production

# The image to run. Left unset, make deploy-up builds one here, which on a
# small host means compiling Go and bundling the client on the host's own
# cores. Set it to the image CI publishes and use make deploy-pull instead.
# VOCALIS_IMAGE=ghcr.io/esuedu/vocalis:latest

# Caddy is on this host and reaches the server over loopback, so the plain-HTTP
# port is deliberately not exposed. Set it to :8080 only if you terminate TLS
# somewhere else, or want the server reachable without TLS at all.
HTTP_ADDR=127.0.0.1:8080

# Two halves of one credential. make deploy-env keeps them in step; if you
# change one by hand, change the other.
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
DATABASE_URL=postgres://vocalis:CHANGE_ME_PASSWORD@127.0.0.1:5432/vocalis?sslmode=disable

# Required when ENV=production, at least 32 bytes. Replacing it logs everybody
# out and invalidates every signed attachment url that is still in flight.
JWT_SECRET=CHANGE_ME_SECRET

# The name Caddy answers on and requests a certificate for. Point its A record
# at this host before starting, or the certificate request fails and retries
# against Let's Encrypt's rate limit.
DOMAIN=vocalis.example.com

# The browser loads the client from this server, so the origins that need
# listing here are the desktop app's -- and it has two, not one. macOS and Linux
# send tauri://localhost; Windows, on WebView2, sends http://tauri.localhost.
# Omitting the Windows one costs nothing until somebody runs the Windows build,
# which then cannot register: the preflight is answered without a matching
# allow-origin, the webview never sends the real request, and the app reports
# that the server did not answer. Keep the https one for the tauri build that
# points at you.
CORS_ORIGINS=https://vocalis.example.com,tauri://localhost,http://tauri.localhost

# Only Caddy, on loopback, may claim to be a client. Anything trusted here can
# forge X-Forwarded-For and walk through the per-IP rate limits.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# The address clients reach this server on. Leave empty when the machine holds
# its public address directly, which is the case for a plain VPS running this
# compose file. Set it on EC2, GCP, or anywhere the public address is mapped to
# a private NIC, or the SFU offers only private candidates and media never
# flows. Open this UDP range on the firewall either way.
WEBRTC_PUBLIC_IP=
WEBRTC_UDP_PORT_MIN=50000
WEBRTC_UDP_PORT_MAX=50999

# STUN is enough for most people. A TURN server relays media for the rest, and
# Vocalis does not ship one: point these at coturn started with
# use-auth-secret, and TURN_SECRET must be that same secret.
ICE_SERVERS=stun:stun.l.google.com:19302
TURN_SECRET=
TURN_TTL=12h

# disk keeps uploads in the named volume mounted at /var/lib/vocalis. Switch to
# s3 and fill the S3_ block if you would rather they lived elsewhere.
STORAGE=disk
STORAGE_DIR=/var/lib/vocalis/files
ATTACHMENT_URL_TTL=24h
S3_ENDPOINT=
S3_BUCKET=vocalis
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_SSL=true

# Grafana's admin password, used only by the observability stack that
# make observe-up starts. Grafana listens on loopback, so this guards a door
# that is only reachable through an ssh tunnel -- but it is still a password.
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA

# Set this to serve Grafana on its own subdomain through Caddy instead of
# through an ssh tunnel. Grafana stays on loopback either way -- Caddy is on the
# host network and reaches it there -- so no port is opened, but the login does
# become reachable from anywhere. Pick the password above accordingly.
# GRAFANA_ROOT_URL=https://grafana.vocalis.example.com/

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
HEARTBEAT_INTERVAL=30s

REGISTER_PER_HOUR=10
LOGIN_PER_MINUTE=20
MESSAGES_PER_MINUTE=60
MAX_SESSIONS_PER_USER=5

# The server applies pending migrations at boot and takes a Postgres advisory
# lock while it does. Set false only if you would rather run them yourself.
MIGRATE_ON_START=true
