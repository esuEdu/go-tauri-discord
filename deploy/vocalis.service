[Unit]
Description=Vocalis: Postgres, the server and Caddy
Documentation=https://github.com/esuEdu/go-tauri-discord/blob/developer/docs/deploy.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__DIR__
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml --profile tls up -d
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml --profile tls down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
